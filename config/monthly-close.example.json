{
  "ollama_url": "http://127.0.0.1:11436",
  "ollama_model": "qwen2.5:7b",
  "browser_executable": "%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe",
  "outlook_url": "https://outlook.live.com/mail/0/",
  "max_messages": 200,
  "selectors_verified": false,
  "folder_scan_verified": false,
  "selectors": {
    "search": "input[placeholder='Buscar']",
