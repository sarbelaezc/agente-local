    "all_folders_active": "[aria-label='Todas las carpetas'][aria-selected='true']",
    "results_ready": "[role='listbox'][aria-label='Resultados de la búsqueda']",
    "rows": "[role='option'][data-itemid]",
    "row_sender": "[email]",
    "row_subject": "[data-testid='message-subject']",
    "scroll_container": "[role='listbox'][aria-label='Resultados de la búsqueda']",
    "selected_row": "[role='option'][data-itemid][aria-selected='true']",
    "message": "[data-testid='message-reading-pane']",
    "sender": "[email]",
    "subject": "[data-testid='message-subject']",
    "received": "time[datetime]",
    "body": "[role='document']",
    "thread_messages": "[data-testid='message-container']"
  }
